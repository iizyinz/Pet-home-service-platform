# =====================================================================
# 宠物上门服务 · 环境变量样例
# 复制为 .env（已被 gitignore）后按需填写，切勿把真实值提交到仓库。
#
# Spring Boot 不会自动读取 .env 文件，请通过以下任一方式注入：
#   PowerShell：  $env:MYSQL_PWD="xxx"; $env:JWT_SECRET="xxx"; .\mvnw.cmd spring-boot:run
#   CMD：        set MYSQL_PWD=xxx && set JWT_SECRET=xxx && mvnw.cmd spring-boot:run
#   Linux/macOS： export MYSQL_PWD=xxx JWT_SECRET=xxx && ./mvnw spring-boot:run
#   IDE：        Run Configuration → Environment variables
# =====================================================================

# ---------- 必填（缺失时后端启动直接失败） ----------
# 数据库密码（默认数据库名 pet_service，账号默认 root，可用 MYSQL_USER 覆盖）
MYSQL_PWD=
# JWT HS256 签名密钥：建议 32 字节以上随机串，例如 openssl rand -base64 48
JWT_SECRET=
# 首次启动时初始化管理员账号 admin 的初始口令（8-32 位；数据库已有管理员时忽略）
ADMIN_INIT_PASSWORD=

# ---------- 可选：数据库账号 ----------
MYSQL_USER=root

# ---------- 可选：Cloudflare R2 对象存储（不配置则图片上传不可用） ----------
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 公开访问域名，如 https://pub-xxx.r2.dev 或自定义域名（末尾不带 /）
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=pet

# ---------- 可选：大模型（OpenAI 兼容接口，默认 DeepSeek） ----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ---------- 可选：生产环境开关 ----------
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
